#!/usr/bin/env bash
# sapper launcher for Git Bash on Windows.
# Loads ../.env.local (model gateway + key) before running the CLI.
HERE="$(cd "$(dirname "$0")" && pwd)"
ENVFILE="$HERE/../.env.local"
if [[ -f "$ENVFILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENVFILE"
  set +a
fi

# Under MSYS_NO_PATHCONV=1 (or MSYS2_ARG_CONV_EXCL=*) the script path is no
# longer translated, so hand python a native Windows path explicitly. Without
# this, `MSYS_NO_PATHCONV=1 sapper fact -d path=/WEB-INF/web.xml` would fail
# before the CLI even starts.
ENTRY="$HERE/sapper_win.py"
if command -v cygpath >/dev/null 2>&1; then
  ENTRY="$(cygpath -w "$ENTRY")"
fi
exec python "$ENTRY" "$@"
