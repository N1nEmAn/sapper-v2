# sapper 本地环境配置 — 只存在于本机，不要提交到任何仓库
# 由 bin\sapper.cmd / bin\sapper 自动加载

# DeepSeek 的 Anthropic 兼容端点
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-f7025bdd6c19407db36c229a3130827c
ANTHROPIC_MODEL=deepseek-flash

# sapper 的引擎模型（会作为 --model 传给 claude）
# deepseek-flash = DeepSeek-V4.1-Flash（API 侧只认这个名字）
SAPPER_MODEL=deepseek-flash

# 国内直连，绕开本机代理
NO_PROXY=api.deepseek.com,127.0.0.1,localhost
no_proxy=api.deepseek.com,127.0.0.1,localhost
